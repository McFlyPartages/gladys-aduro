{
  "manifest_version": 1,
  "type": "device",
  "name": "Aduro",
  "description": {
    "en": "Control Aduro hybrid pellet stoves (H1 to H6) on your local network.",
    "fr": "Pilotez les poêles hybrides à granulés Aduro (H1 à H6) sur votre réseau local."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/mcflypartages/gladys-aduro:0.1.0",
  "gladys_version": ">=5.1.0",
  "categories": ["climate"],
  "transports": ["local", "cloud"],
  "network_discovery": [{ "type": "udp-active-broadcast", "ports": [8483] }],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Your stove", "fr": "Votre poêle" },
      "description": {
        "en": "The serial number and the PIN code are on the sticker of the stove, the same ones the Aduro Hybrid app asks for. Give a fixed IP address when the stove is on another network (VLAN) than Gladys: it cannot be found by broadcast then.",
        "fr": "Le numéro de série et le code PIN figurent sur l'étiquette du poêle : ce sont ceux que demande l'application Aduro Hybrid. Indiquez une adresse IP fixe si le poêle est sur un autre réseau (VLAN) que Gladys : il n'est alors pas trouvable par diffusion."
      }
    },
    {
      "key": "stove_serial",
      "type": "string",
      "label": { "en": "Serial number", "fr": "Numéro de série" },
      "placeholder": { "en": "123456", "fr": "123456" },
      "required": true
    },
    {
      "key": "stove_pin",
      "type": "secret",
      "label": { "en": "PIN code", "fr": "Code PIN" },
      "required": true
    },
    {
      "key": "stove_ip",
      "type": "string",
      "label": { "en": "IP address (optional)", "fr": "Adresse IP (facultative)" },
      "description": {
        "en": "Leave empty to find the stove on the local network.",
        "fr": "Laissez vide pour rechercher le poêle sur le réseau local."
      },
      "placeholder": { "en": "192.168.1.50", "fr": "192.168.1.50" },
      "required": false
    },
    {
      "key": "stove_model",
      "type": "select",
      "label": { "en": "Model", "fr": "Modèle" },
      "options": [
        { "value": "H1", "label": { "en": "H1", "fr": "H1" } },
        { "value": "H2", "label": { "en": "H2", "fr": "H2" } },
        { "value": "H3", "label": { "en": "H3", "fr": "H3" } },
        { "value": "H4", "label": { "en": "H4 (not confirmed)", "fr": "H4 (non confirmé)" } },
        { "value": "H5", "label": { "en": "H5", "fr": "H5" } },
        { "value": "H6", "label": { "en": "H6 (not confirmed)", "fr": "H6 (non confirmé)" } }
      ],
      "required": false,
      "default": "H2"
    },
    {
      "key": "cloud_relay",
      "type": "boolean",
      "label": { "en": "Use the Aduro cloud relay", "fr": "Utiliser le relais cloud Aduro" },
      "description": {
        "en": "Off by default. When on, a stove that cannot be reached locally is reached through the Aduro relay (apprelay20.stokercloud.dk), as the Aduro app does: the serial number and the PIN code then travel unencrypted over the Internet.",
        "fr": "Désactivé par défaut. Activé, un poêle injoignable en local est joint par le relais Aduro (apprelay20.stokercloud.dk), comme le fait l'application Aduro : le numéro de série et le code PIN circulent alors en clair sur Internet."
      },
      "required": false,
      "default": false
    },
    {
      "key": "language",
      "type": "select",
      "label": { "en": "Language of the states", "fr": "Langue des états" },
      "description": {
        "en": "Language of the state texts and of the feature names given to a new device.",
        "fr": "Langue des textes d'état et des noms de fonctionnalités donnés à un nouvel appareil."
      },
      "options": [
        { "value": "en", "label": { "en": "English", "fr": "Anglais" } },
        { "value": "fr", "label": { "en": "French", "fr": "Français" } }
      ],
      "required": false,
      "default": "en"
    },
    {
      "key": "pellets",
      "type": "section",
      "label": { "en": "Pellets", "fr": "Granulés" },
      "description": {
        "en": "What is left in the hopper is computed from the consumption the stove reports: press the \"Pellets refilled\" button of the device after filling it up.",
        "fr": "Le contenu restant de la trémie est calculé à partir de la consommation remontée par le poêle : appuyez sur le bouton « Granulés rechargés » de l'appareil après chaque remplissage."
      }
    },
    {
      "key": "pellet_capacity",
      "type": "number",
      "label": { "en": "Hopper capacity (kg)", "fr": "Capacité de la trémie (kg)" },
      "min": 1,
      "max": 100,
      "required": false,
      "default": 9.5
    },
    {
      "key": "low_pellet_level",
      "type": "number",
      "label": { "en": "Low pellets alert (%)", "fr": "Alerte granulés bas (%)" },
      "min": 0,
      "max": 100,
      "required": false,
      "default": 10
    },
    {
      "key": "shutdown_level",
      "type": "number",
      "label": { "en": "Automatic stop level (%)", "fr": "Seuil d'arrêt automatique (%)" },
      "description": {
        "en": "Used when the \"Stop at low pellets\" switch of the device is on.",
        "fr": "Utilisé quand l'interrupteur « Arrêt si granulés bas » de l'appareil est activé."
      },
      "min": 0,
      "max": 100,
      "required": false,
      "default": 5
    },
    {
      "key": "alerts",
      "type": "section",
      "label": { "en": "Temperature alerts", "fr": "Alertes de température" },
      "description": {
        "en": "An alert fires the matching scene trigger once the temperature stayed past its threshold for the given duration.",
        "fr": "Une alerte déclenche le déclencheur de scène correspondant quand la température est restée au-delà du seuil pendant la durée indiquée."
      }
    },
    {
      "key": "high_smoke_temp",
      "type": "number",
      "label": { "en": "Smoke too hot (°C)", "fr": "Fumées trop chaudes (°C)" },
      "min": 300,
      "max": 450,
      "required": false,
      "default": 370
    },
    {
      "key": "high_smoke_duration",
      "type": "number",
      "label": { "en": "Smoke too hot for (s)", "fr": "Fumées trop chaudes pendant (s)" },
      "min": 10,
      "max": 1800,
      "required": false,
      "default": 30
    },
    {
      "key": "low_wood_temp",
      "type": "number",
      "label": { "en": "Wood fire dying (°C)", "fr": "Feu de bois qui faiblit (°C)" },
      "min": 20,
      "max": 200,
      "required": false,
      "default": 175
    },
    {
      "key": "low_wood_duration",
      "type": "number",
      "label": { "en": "Wood fire dying for (s)", "fr": "Feu de bois qui faiblit pendant (s)" },
      "min": 10,
      "max": 1800,
      "required": false,
      "default": 300
    },
    {
      "key": "manual",
      "type": "section",
      "label": { "en": "Forced outputs", "fr": "Sorties forcées" },
      "description": {
        "en": "Longest run of the \"Forced fan\" and \"Forced auger\" switches. The forced fan also stops above 320 °C of smoke.",
        "fr": "Durée maximale des interrupteurs « Ventilateur forcé » et « Vis sans fin forcée ». Le ventilateur forcé s'arrête aussi au-delà de 320 °C de fumées."
      }
    },
    {
      "key": "force_fan_duration",
      "type": "number",
      "label": { "en": "Forced fan (s)", "fr": "Ventilateur forcé (s)" },
      "min": 1,
      "max": 900,
      "required": false,
      "default": 60
    },
    {
      "key": "force_auger_duration",
      "type": "number",
      "label": { "en": "Forced auger (s)", "fr": "Vis sans fin forcée (s)" },
      "min": 1,
      "max": 300,
      "required": false,
      "default": 15
    }
  ],
  "scene_triggers": [
    {
      "key": "high_smoke_temperature",
      "label": { "en": "Stove smoke too hot", "fr": "Fumées du poêle trop chaudes" },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Stove", "fr": "Poêle" },
          "required": true
        }
      ],
      "variables": [
        {
          "key": "temperature",
          "type": "number",
          "label": { "en": "Smoke temperature", "fr": "Température des fumées" }
        }
      ]
    },
    {
      "key": "low_wood_temperature",
      "label": { "en": "Stove wood fire dying", "fr": "Feu de bois du poêle qui faiblit" },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Stove", "fr": "Poêle" },
          "required": true
        }
      ],
      "variables": [
        {
          "key": "temperature",
          "type": "number",
          "label": { "en": "Smoke temperature", "fr": "Température des fumées" }
        }
      ]
    },
    {
      "key": "low_pellets",
      "label": { "en": "Stove pellets low", "fr": "Granulés du poêle bas" },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Stove", "fr": "Poêle" },
          "required": true
        }
      ],
      "variables": [
        {
          "key": "percentage",
          "type": "number",
          "label": { "en": "Pellets level (%)", "fr": "Niveau de granulés (%)" }
        },
        {
          "key": "remaining_kg",
          "type": "number",
          "label": { "en": "Pellets left (kg)", "fr": "Granulés restants (kg)" }
        }
      ]
    },
    {
      "key": "pellet_shutdown",
      "label": { "en": "Stove stopped at low pellets", "fr": "Poêle arrêté faute de granulés" },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Stove", "fr": "Poêle" },
          "required": true
        }
      ],
      "variables": [
        {
          "key": "percentage",
          "type": "number",
          "label": { "en": "Pellets level (%)", "fr": "Niveau de granulés (%)" }
        },
        {
          "key": "remaining_kg",
          "type": "number",
          "label": { "en": "Pellets left (kg)", "fr": "Granulés restants (kg)" }
        }
      ]
    },
    {
      "key": "stove_fault",
      "label": { "en": "Stove fault", "fr": "Défaut du poêle" },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Stove", "fr": "Poêle" },
          "required": true
        }
      ],
      "variables": [
        {
          "key": "state_code",
          "type": "number",
          "label": { "en": "State code", "fr": "Code d'état" }
        },
        { "key": "state_label", "type": "string", "label": { "en": "State", "fr": "État" } }
      ]
    }
  ]
}
